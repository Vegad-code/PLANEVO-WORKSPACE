{
  "name": "planevo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:rls": "node scripts/verify-rls.mjs",
    "db:push": "supabase db push",
    "db:seed": "node scripts/seed-dev.mjs",
    "icons:generate": "node scripts/generate-icon-catalog.mjs",
    "icons:seed": "node scripts/seed-icon-catalog.mjs",
    "db:types": "supabase gen types typescript --project-id aixvpsmpiucticxutngp --schema public > packages/core/src/types/database.types.ts",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "playwright": "^1.62.0",
    "supabase": "^2.109.1"
  }
}
