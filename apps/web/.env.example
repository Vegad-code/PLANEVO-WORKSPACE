# =============================================================================
# SUPABASE
# Copy to apps/web/.env.local — never commit real secrets.
# Dashboard → Project Settings → API Keys
# =============================================================================

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# --- Public keys (browser-safe — NEXT_PUBLIC_ is intentional) ---

# New publishable key (preferred)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy anon key (fallback if publishable is unset)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Server secrets (NEVER prefix with NEXT_PUBLIC_ — never ship to the browser) ---

# New secret key (preferred for admin / seed / bypassing RLS)
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy service_role key (fallback if secret is unset)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Personal access token (Account → Access Tokens). Agents use this for
# Management API SQL against project aixvpsmpiucticxutngp. Never commit real values.
SUPABASE_ACCESS_TOKEN=sbp_...


# =============================================================================
# PLANEVO — local development
# =============================================================================

# Dev-mode data access (service-role impersonation, bypasses RLS).
# Requires ALL of: PLANEVO_DEV_MODE=1, PLANEVO_DEV_OWNER_ID, a server secret key,
# and a non-production build. Leave both unset in production — prod runs on
# real Supabase Auth with only the URL + publishable key.
PLANEVO_DEV_MODE=1
PLANEVO_DEV_OWNER_ID=b0000000-0000-4000-8000-000000000001


# =============================================================================
# CALENDAR CONNECTIONS — server-only
# =============================================================================

# Generate once with: openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth web client with this callback:
# https://your-app.example/api/calendar-connections/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Public production origin and HTTPS webhook registered with Google.
NEXT_PUBLIC_APP_URL=https://your-app.example
CALENDAR_GOOGLE_WEBHOOK_URL=https://your-app.example/api/calendar-connections/google/webhook

# Sent by the hourly Vercel cron as Authorization: Bearer <value>.
CRON_SECRET=
